# Club Viva Environment Variables Template
# Copy this file to .env.local and populate the secrets

# Environment
NODE_ENV=production

# Cloudflare Turnstile CAPTCHA (Optional / Production)
# Cloudflare testing keys:
# Site Key: 1x00000000000000000000AA (always passes)
# Secret Key: 1x0000000000000000000000000000000AA (always passes)
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Anti-Abuse Rate Limiting
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=600000

# Minimum human interaction time (milliseconds)
MIN_FORM_TIME_MS=3000
